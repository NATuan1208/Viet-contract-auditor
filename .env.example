# ── Required ─────────────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── Optional fallback (used when OPENAI_API_KEY is absent) ───────────────────
CEREBRAS_API_KEY=

# ── Deployment profile ───────────────────────────────────────────────────────
# production : Neo4j + Qdrant + PostgreSQL (requires docker compose up -d)
# demo       : LightRAG JSON/NanoVectorDB from lightrag_index/ (single container, HF Spaces)
STORAGE_PROFILE=production

# ── Optional: force a specific LLM model name ────────────────────────────────
# AUDIT_LLM_MODEL=gpt-4o-mini

# LightRAG retrieval rerank (production-local)
# Default uses a local multilingual cross-encoder. Override with a larger reranker
# only when CPU/RAM latency is acceptable.
LIGHTRAG_RERANK_ENABLED=true
LIGHTRAG_RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
LIGHTRAG_RERANK_BATCH_SIZE=16
LIGHTRAG_RERANK_MAX_CHARS=4000
LIGHTRAG_RERANK_NORMALIZE_SCORES=true
LIGHTRAG_MIN_RERANK_SCORE=0.0

# LightRAG benchmark knobs (trace is opt-in because queries may include
# contract text; set preview chars to 0 to store hashes only).
LIGHTRAG_QUERY_TOP_K=10
LIGHTRAG_CHUNK_TOP_K=20
LIGHTRAG_CONTEXT_MAX_CHARS=1000
LIGHTRAG_BENCHMARK_TRACE_ENABLED=false
LIGHTRAG_BENCHMARK_TRACE_PATH=reports/benchmarks/retrieval_trace.jsonl
LIGHTRAG_TRACE_PREVIEW_CHARS=180

# ── Neo4j credentials (used in production profile) ───────────────────────────
# NEO4J_AUTH=neo4j/contract_audit_2024

# ── PostgreSQL credentials (used in production profile) ──────────────────────
# NOTE: port 5433 (not 5432) — Windows Hyper-V reserves 55432 which was the old default
# POSTGRES_PORT=5433
# POSTGRES_DB=viet_contract
# POSTGRES_USER=rag
# POSTGRES_PASSWORD=rag_secure_pwd
# POSTGRES_DSN=postgresql://rag:rag_secure_pwd@127.0.0.1:5433/viet_contract
